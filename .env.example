# Set these privately in GoDaddy preview secrets. Never commit a real .env file.
NEXT_PUBLIC_SUPABASE_URL=https://conganplywqzmuktmyxd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SERVER_KEY=replace_with_current_secret_key
# Use the userId in your LATEST OG backup manifest.json. Do not use the Supabase project ID.
OG_WORKSPACE_ID=replace_with_original_workspace_id
# Exact preview origin first; change to https://og.opervixgroup.com for production.
OG_APP_URL=https://replace-with-preview-host
# Choose a private random token of at least 32 characters for the first Global Admin setup.
OG_BOOTSTRAP_TOKEN=replace_with_a_private_random_setup_token
NEXT_TELEMETRY_DISABLED=1

# Phase 6: disabled until registrations, mailbox scope and live tests are approved.
OG_MICROSOFT_LOGIN_ENABLED=false
OG_MICROSOFT_TENANT_ID=
OG_WORK_EMAIL_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OG_WORK_EMAIL_CRON_SECRET=
